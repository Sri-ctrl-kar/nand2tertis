// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
   
    // 1. Increment the current output value
    Inc16(in=prevOut, out=incOut);
    
    // 2. Select between keeping the current value or incrementing
    Mux16(a=prevOut, b=incOut, sel=inc, out=mux1Out);
    
    // 3. Select whether to load the new input 'in'
    Mux16(a=mux1Out, b=in, sel=load, out=mux2Out);
    
    // 4. Select whether to reset the counter to 0
    Mux16(a=mux2Out, b=false, sel=reset, out=regIn);
    
    // 5. Store the value in the register and output it
    Register(in=regIn, load=true, out=prevOut, out=out);
}